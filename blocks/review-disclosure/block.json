{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sit-cwm/review-disclosure",
	"title": "Review disclosure",
	"category": "text",
	"description": "Shows who approved this content and its declared AI use.",
	"textdomain": "sapphireit-editorial-workflow",
	"attributes": {
		"showReviewer": { "type": "boolean", "default": true },
		"showAiOrigin": { "type": "boolean", "default": true }
	},
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"typography": { "fontSize": true },
		"spacing": { "margin": true, "padding": true },
		"color": { "text": true, "background": true }
	},
	"editorScript": "sit-cwm-review-disclosure-js"
}
