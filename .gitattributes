# Normalize to LF so phpcs line-ending sniffs pass on Windows checkouts.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Development only: kept out of `git archive` / `composer archive` release zips.
# Keep in sync with .distignore, which does the same job for bin/build-zip.php.
