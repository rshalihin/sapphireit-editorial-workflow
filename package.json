{
  "name": "sapphireit-editorial-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "Editorial approval workflow for WordPress posts, pages and custom post types.",
  "author": "SapphireIT",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "format": "wp-scripts format",
    "test:unit": "wp-scripts test-unit-js",
    "test:e2e": "wp-scripts test-playwright",
    "test:e2e:local": "node bin/e2e-local.js",
    "env:start": "wp-env start",
    "makepot": "wp i18n make-pot . languages/sapphireit-editorial-workflow.pot --domain=sapphireit-editorial-workflow --slug=sapphireit-editorial-workflow --exclude=tests,bin,artifacts,.github,.claude",
    "screenshots": "node bin/capture-screenshots.js",
    "build:zip": "php bin/build-zip.php --out=dist",
    "check:version": "php bin/check-version.php"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@wordpress/a11y": "^4.55.0",
    "@wordpress/api-fetch": "^7.55.0",
    "@wordpress/components": "^40.1.0",
    "@wordpress/compose": "^8.8.0",
    "@wordpress/data": "^10.55.0",
    "@wordpress/dataviews": "11.3.0",
    "@wordpress/date": "^5.55.0",
    "@wordpress/e2e-test-utils-playwright": "^2.0.0",
    "@wordpress/edit-post": "^8.55.0",
    "@wordpress/editor": "^15.0.0",
    "@wordpress/element": "^8.7.0",
    "@wordpress/env": "^11.15.0",
    "@wordpress/eslint-plugin": "^26.0.0",
    "@wordpress/i18n": "^6.28.0",
    "@wordpress/icons": "^16.0.0",
    "@wordpress/notices": "^5.55.0",
    "@wordpress/plugins": "^7.55.0",
    "@wordpress/prettier-config": "^4.55.0",
    "@wordpress/scripts": "^35.0.0",
    "prettier": "npm:wp-prettier@^3.9.6"
  }
}
